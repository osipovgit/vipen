[Unit]
Description=Run 3x-ui database backup on a schedule

[Timer]
OnCalendar={{ xui_backup_timer_schedule }}
# Spread the run out: on a 1 vCPU VPS logrotate, atop and dpkg-db-backup all
# fire at midnight already.
RandomizedDelaySec=15min
# Catch up after downtime instead of silently skipping a day.
Persistent=true

[Install]
WantedBy=timers.target
