#!/usr/bin/env bash
set -euo pipefail
umask 077

# Both the online SQLite copy and the entire service have bounded execution.
if result="$(timeout --kill-after=5 {{ xui_backup_timeout_seconds }} python3 /usr/local/libexec/vipen/xui_backup.py <<'JSON'
{{ {'database': xui_db_dir ~ '/x-ui.db', 'backup_dir': xui_backup_dir, 'compose': xui_compose_dir ~ '/docker-compose.yml', 'cert_dir': xui_cert_dir, 'container': xui_container_name, 'keep': xui_backup_keep} | to_json }}
JSON
)"; then
  logger -t xui-backup "status=OK integrity=ok"
  printf '%s\n' "$result"
else
  logger -t xui-backup "status=FAIL reason=snapshot_failed_or_deployment_active"
  exit 1
fi
