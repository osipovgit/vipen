#!/usr/bin/env bash
#
# Daily digest of vps-host-monitor anomalies, sent as a single Telegram message.
#
# The monitor samples every 5 seconds, so a bad night on the hypervisor produces
# hundreds of WARN lines - which is why it is deliberately not wired to alerting
# directly. Aggregating a whole day into one message is the rate limiter: the
# successful deliveries are recorded by day; failed/uncertain sends can retry.
#
# Days with samples but no anomalies send nothing. Missing coverage is an error.
#
# Runs after midnight. Delivery failures remain visible and can be retried.
# A private day marker suppresses repeated successful sends after a restart.
set -uo pipefail
umask 077

# cpu_steal_pct is a decimal fraction. Under a locale that uses a comma, awk
# both parses "31.07" as 31 and prints it back with a comma - silently losing
# the number that the whole report is about. Pin the numeric format instead of
# trusting whatever locale the timer inherits.
export LC_ALL=C

notify={{ vpn_monitor_alert_script_path | quote }}

log() { logger -t vps-host-daily "$1"; }

day="$(date -d yesterday +%Y-%m-%d)"

state_dir={{ vpn_monitor_digest_state_dir | quote }}
mkdir -p "$state_dir"
chmod 0700 "$state_dir"
exec 9>"$state_dir/lock"
flock -n 9 || exit 0
[ -f "$state_dir/$day.sent" ] && exit 0
if journal="$(timeout {{ vpn_monitor_command_timeout_seconds }} journalctl -q -t vps-host-monitor --since yesterday --until today -o short-iso --no-pager 2>/dev/null)"; then
  warnings="$(printf '%s\n' "$journal" | grep 'status=WARN' || true)"
else
  log "status=FAIL reason=journal_unavailable"
  exit 1
fi
# An empty journal is missing coverage, not proof of an incident-free day.
if ! printf '%s\n' "$journal" | grep -Eq 'status=(SUMMARY|WARN)'; then
  log "status=FAIL reason=monitor_samples_missing"
  exit 1
fi

if [ -z "$warnings" ]; then
  log "status=OK day=${day} anomalies=0"
  touch "$state_dir/$day.sent"
  exit 0
fi

# One pass over the day: totals, worst values and a per-hour histogram. The
# histogram is the part that matters for a hosting complaint - it shows whether
# the trouble was one burst or spread across the night.
summary="$(printf '%s\n' "$warnings" | awk '
  {
    total++
    hour = substr($1, 12, 2)
    per_hour[hour]++
    if (first == "") first = substr($1, 12, 8)
    last = substr($1, 12, 8)
    for (i = 1; i <= NF; i++) {
      if ($i ~ /^scheduler_delay_ms=/) {
        split($i, kv, "=")
        if (kv[2] + 0 > max_delay) max_delay = kv[2] + 0
      }
      if ($i ~ /^cpu_steal_pct=/) {
        split($i, kv, "=")
        if (kv[2] + 0 > max_steal) max_steal = kv[2] + 0
      }
    }
  }
  END {
    printf "Anomalies: %d (from %s to %s)\n", total, first, last
    printf "Peak scheduler delay: %d ms\n", max_delay
    printf "Peak CPU steal: %.2f%%\n", max_steal
    printf "By hour:"
    # Counting up gives chronological order without sorting the array.
    for (h = 0; h < 24; h++) {
      slot = sprintf("%02d", h)
      if (slot in per_hour) printf " %s:00 x%d", slot, per_hour[slot]
    }
    printf "\n"
  }
')"

count="$(printf '%s\n' "$warnings" | wc -l | tr -d ' ')"
log "status=REPORT day=${day} anomalies=${count}"

if [ ! -x "$notify" ]; then
  # Alerting is off or unconfigured. The digest still belongs in the journal.
  log "status=SKIP reason=notify_unavailable"
  printf '%s\n' "$summary"
  exit 1
fi

if "$notify" --report "hypervisor anomalies on ${day}" "${summary}
Details: journalctl -t vps-host-monitor --since \"${day} 00:00\" --until \"${day} 23:59\""; then
  touch "$state_dir/$day.sent"
  find "$state_dir" -name "*.sent" -mtime +90 -delete
else
  log "status=FAIL reason=delivery_failed"
  exit 1
fi
