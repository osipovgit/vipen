#!/usr/bin/env bash
set -uo pipefail
umask 077
export LC_ALL=C

container={{ vpn_monitor_container_name | quote }}
panel_host={{ vpn_monitor_panel_host | quote }}
panel_port={{ vpn_monitor_panel_port | quote }}
disk_warn={{ vpn_monitor_disk_warn_percent | quote }}
disk_fail={{ vpn_monitor_disk_fail_percent | quote }}
mem_warn={{ vpn_monitor_mem_warn_mb | quote }}
conntrack_warn={{ vpn_monitor_conntrack_warn_percent | quote }}
backup_dir={{ vpn_monitor_backup_dir | quote }}
backup_max_age_hours={{ vpn_monitor_backup_max_age_hours | quote }}
auto_restart="{{ vpn_monitor_auto_restart | bool | ternary('true', 'false') }}"
failure_threshold={{ vpn_monitor_failure_threshold | quote }}
state_file={{ vpn_monitor_state_file | quote }}

# Diagnostic (non-mutating) mode: report status/exit code but never touch the
# shared failure counter and never restart the container. Used by the manual
# healthcheck so diagnostics can't trigger an auto-restart. Enable with the
# --no-restart flag or VPN_HEALTH_NO_RESTART=1.
no_restart="false"
for arg in "$@"; do
  case "$arg" in
    --no-restart|--diagnostic|--dry-run) no_restart="true" ;;
  esac
done
[ "${VPN_HEALTH_NO_RESTART:-}" = "1" ] && no_restart="true"

command_timeout={{ vpn_monitor_command_timeout_seconds | quote }}
# Keep a shared lock until this process exits, including any restart below.
# Backups also hold shared locks; deployment requires an exclusive lock.
if ! exec 9>>{{ vpn_monitor_deploy_lock_file | quote }}; then
  printf 'status=FAIL deployment_lock_unavailable\n'
  exit 1
fi
if ! flock -s -n 9; then
  printf 'status=WARN maintenance=deployment_in_progress\n'
  exit 0
fi

tcp_ports=({% for port in vpn_monitor_tcp_ports %}{{ port }}{% if not loop.last %} {% endif %}{% endfor %})

restart_eligible="false"
status="OK"
messages=()

mark_warn() {
  if [ "$status" = "OK" ]; then
    status="WARN"
  fi
  messages+=("$1")
}

mark_fail() {
  status="FAIL"
  messages+=("$1")
}

check_tcp() {
  local host="$1"
  local port="$2"
  # shellcheck disable=SC2016 # Expanded by the child shell from positional arguments.
  timeout 5 bash -c 'exec 3<>/dev/tcp/$1/$2' _ "$host" "$port" >/dev/null 2>&1
}

if ! command -v docker >/dev/null 2>&1; then
  mark_fail "docker command missing"
else
  running="$(timeout "$command_timeout" docker inspect -f '{{ "{{" }}.State.Running{{ "}}" }}' "$container" 2>/dev/null || true)"
  restart_count="$(timeout "$command_timeout" docker inspect -f '{{ "{{" }}.RestartCount{{ "}}" }}' "$container" 2>/dev/null || echo unknown)"
  if [ "$running" != "true" ]; then
    restart_eligible="true"
    mark_fail "container ${container} not running"
  else
    messages+=("container=${container} running restart_count=${restart_count}")
  fi
fi

if ! check_tcp "$panel_host" "$panel_port"; then
  restart_eligible="true"
  mark_fail "panel tcp ${panel_host}:${panel_port} unavailable"
else
  messages+=("panel_tcp=${panel_host}:${panel_port} ok")
fi

# Read listeners on every run: clients/inbounds may change through the panel.
listeners=""
inbound_count=0
if db_state="$(timeout "$command_timeout" python3 "{{ vpn_monitor_db_tool_path }}" inspect "{{ vpn_monitor_db_dir }}/x-ui.db" 2>/dev/null)"; then
  listeners="$(printf '%s' "$db_state" | python3 -c 'import json,sys; d=json.load(sys.stdin); [print(p["host"], p["port"]) for p in d["tcp_listeners"]]; print(d["subscription_listen"], d["subscription_port"]) if d["subscription_enabled"] else None')"
  inbound_count="$(printf '%s' "$db_state" | python3 -c 'import json,sys; print(json.load(sys.stdin)["inbound_count"])')"
else
  mark_fail "database_listener_discovery_failed"
fi
for port in "${tcp_ports[@]}"; do
  listeners+=$'\n'"127.0.0.1 $port"
done
while read -r host port; do
  [ -z "$port" ] && continue
  if ! check_tcp "$host" "$port"; then
    restart_eligible="true"
    mark_fail "local tcp ${host}:${port} unavailable"
  else
    messages+=("local_tcp=${host}:${port} ok")
  fi
done <<< "$listeners"

if [ "$inbound_count" -eq 0 ]; then
{% if vpn_monitor_expect_inbounds | bool %}
  mark_fail "no_enabled_inbounds"
{% else %}
  mark_warn "bootstrap_no_enabled_inbounds"
{% endif %}
elif command -v docker >/dev/null 2>&1 && [ "${running:-false}" = "true" ]; then
  if timeout "$command_timeout" docker exec "$container" sh -lc 'ps | grep -q "[x]ray-linux"' >/dev/null 2>&1; then
    messages+=("xray_process=ok")
  else
    restart_eligible="true"
    mark_fail "xray process missing inside container"
  fi
fi

disk_used="$(df -P / | awk 'NR==2 {gsub("%", "", $5); print $5}')"
if [ -n "$disk_used" ]; then
  if [ "$disk_used" -ge "$disk_fail" ]; then
    mark_fail "disk_used=${disk_used}%"
  elif [ "$disk_used" -ge "$disk_warn" ]; then
    mark_warn "disk_used=${disk_used}%"
  else
    messages+=("disk_used=${disk_used}%")
  fi
fi

mem_available_mb="$(awk '/MemAvailable/ {print int($2 / 1024)}' /proc/meminfo)"
if [ -n "$mem_available_mb" ]; then
  if [ "$mem_available_mb" -lt "$mem_warn" ]; then
    mark_warn "mem_available=${mem_available_mb}MB"
  else
    messages+=("mem_available=${mem_available_mb}MB")
  fi
fi

if [ -r /proc/sys/net/netfilter/nf_conntrack_count ] && [ -r /proc/sys/net/netfilter/nf_conntrack_max ]; then
  conntrack_count="$(cat /proc/sys/net/netfilter/nf_conntrack_count)"
  conntrack_max="$(cat /proc/sys/net/netfilter/nf_conntrack_max)"
  conntrack_used=$((conntrack_count * 100 / conntrack_max))
  if [ "$conntrack_used" -ge "$conntrack_warn" ]; then
    mark_warn "conntrack=${conntrack_count}/${conntrack_max} (${conntrack_used}%)"
  else
    messages+=("conntrack=${conntrack_count}/${conntrack_max}")
  fi
fi

# Backup freshness. A backup that quietly stopped running looks exactly like a
# working one until the day it is needed, which is the worst possible day to
# find out. WARN, not FAIL: the VPN itself is still serving traffic.
if [ -n "$backup_dir" ] && [ "$backup_max_age_hours" -gt 0 ]; then
  backup_state="$(timeout "$command_timeout" systemctl is-active xui-backup.service 2>/dev/null || true)"
  case "$backup_state" in
    activating | active | reloading)
      # A snapshot is being written right now, so the newest finished one is by
      # definition the previous run. Judging age here would raise an alarm
      # precisely while the backup is doing its job - and after downtime, when
      # the catch-up run starts against a days-old snapshot, it would fire every
      # single time. The snapshot itself is published atomically, so the only
      # thing left to avoid is this timing window.
      messages+=("backup=in_progress")
      ;;
    *)
      newest_backup="$(find "$backup_dir" -maxdepth 1 -type f -name 'x-ui.db.auto-*' -printf '%T@\n' 2>/dev/null | sort -n | tail -n 1)"
      if [ -z "$newest_backup" ]; then
        mark_warn "backup_missing dir=${backup_dir}"
      else
        backup_age_hours=$(( ( $(date +%s) - ${newest_backup%.*} ) / 3600 ))
        if [ "$backup_age_hours" -ge "$backup_max_age_hours" ]; then
          mark_warn "backup_stale=${backup_age_hours}h"
        else
          messages+=("backup_age=${backup_age_hours}h")
        fi
      fi
      ;;
  esac
fi

# systemd's own failure list. This is the one check that also covers the
# monitoring itself: a broken xui-backup.timer or vps-host-daily.service would
# otherwise fail silently, and nothing else here would ever notice.
failed_units="$(timeout "$command_timeout" systemctl list-units --state=failed --no-legend --plain 2>/dev/null | awk '{print $1}' | paste -sd, - | cut -c1-200)" || mark_warn "systemd_query_failed"
if [ -n "$failed_units" ]; then
  mark_warn "failed_units=${failed_units}"
fi

# Security posture. Both of these degrade without ever failing, so the check
# above cannot see them: `ufw disable` leaves ufw.service happily "active", and
# a stopped fail2ban is merely inactive. WARN rather than FAIL on purpose - the
# VPN keeps serving traffic, and FAIL would feed the auto-restart path, which
# would bounce the container over a problem restarting cannot fix.
#
# Ask ufw itself rather than systemd, for the reason above. A missing binary
# fails the pipeline and lands in the same branch, which is the answer we want.
if timeout "$command_timeout" ufw status 2>/dev/null | grep -q '^Status: active'; then
  messages+=("ufw=active")
else
  mark_warn "ufw_inactive"
fi

fail2ban_state="$(timeout "$command_timeout" systemctl is-active fail2ban 2>/dev/null || true)"
if [ "$fail2ban_state" = "active" ]; then
  messages+=("fail2ban=active")
else
  mark_warn "fail2ban=${fail2ban_state:-unknown}"
fi

# Clock drift is the quietest failure mode in this list: REALITY authenticates
# with a timestamp, so once the clock slides far enough the server starts
# rejecting new handshakes while the container, the ports and the xray process
# all still look perfectly healthy. Reads the kernel sync flag, so it is true
# for whichever NTP client disciplines the clock, not just systemd-timesyncd.
if [ "$(timeout "$command_timeout" timedatectl show -p NTPSynchronized --value 2>/dev/null)" = "yes" ]; then
  messages+=("time_sync=ok")
else
  mark_warn "time_unsynced"
fi

# Informational metrics. These never change status; they add visibility for
# diagnosing "sometimes slow / times out" without needing a heavier monitor.
load1="$(awk '{print $1}' /proc/loadavg 2>/dev/null)"
[ -n "$load1" ] && messages+=("load1=${load1}")

if command -v ss >/dev/null 2>&1; then
  established=0
  for port in "${tcp_ports[@]}"; do
    port_conns="$(timeout "$command_timeout" ss -H -tn state established "( sport = :${port} )" 2>/dev/null | wc -l)"
    established=$((established + port_conns))
  done
  messages+=("established=${established}")
fi

if timeout "$command_timeout" journalctl -q -k --since "2 minutes ago" --no-pager 2>/dev/null | grep -q 'clocksource: Long readout interval'; then
  mark_warn "hypervisor_pause_detected"
fi

failures=0
if [ -r "$state_file" ]; then
  failures="$(cat "$state_file" 2>/dev/null || echo 0)"
fi
case "$failures" in
  ''|*[!0-9]*) failures=0 ;;
esac

if [ "$no_restart" = "true" ]; then
  # Diagnostic mode: read-only. Report the current stored counter without
  # mutating it and without restarting the container.
  messages+=("mode=diagnostic")
else
  if [ "$status" = "FAIL" ]; then
    failures=$((failures + 1))
    printf '%s\n' "$failures" > "$state_file"
  else
    failures=0
    printf '0\n' > "$state_file"
  fi

  if [ "$restart_eligible" = "true" ] && [ "$status" = "FAIL" ] && [ "$auto_restart" = "true" ] && [ "$failures" -ge "$failure_threshold" ]; then
    if command -v docker >/dev/null 2>&1; then
      messages+=("auto_restart=triggered failures=${failures}")
      if timeout --kill-after=5 "$command_timeout" docker restart "$container" >/dev/null 2>&1; then
        printf '0\n' > "$state_file"
      else
        messages+=("auto_restart=failed_or_timed_out")
      fi
    fi
  fi
fi

line="status=${status} failures=${failures} ${messages[*]}"
if [ "$no_restart" = "true" ]; then logger -t vpn-health-diagnostic "$line"; else logger -t vpn-health "$line"; fi
printf '%s\n' "$line"

# Push notification. Skipped in diagnostic mode so a manual run can never spam
# alerts. vpn-notify owns all alert policy (severity filter, threshold,
# anti-flap repeat interval) and always exits 0, so it cannot affect the check.
{% if vpn_monitor_alert_enabled | bool %}
if [ "$no_restart" != "true" ] && [ -x "{{ vpn_monitor_alert_script_path }}" ]; then
  "{{ vpn_monitor_alert_script_path }}" "$status" "${messages[*]}" "$failures" || true
fi
{% endif %}

if [ "$status" = "FAIL" ]; then
  exit 1
fi
