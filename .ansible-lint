---
profile: production

exclude_paths:
  - .github/
  - backups/
  - .ansible/
  # Ciphertext, not source. The first line is the ansible-vault header, so
  # yaml[document-start] can never be satisfied - the *decrypted* content does
  # start with "---". Shows up only on machines that have the vault password;
  # the file is gitignored, so CI never sees it at all.
  - inventories/production/secrets.yml
