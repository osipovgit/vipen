---
extends: default

ignore: |
  backups/
  .ansible/

rules:
  # This project favours readable, long single-line vars/commands.
  line-length:
    max: 200
    level: warning
  comments:
    min-spaces-from-content: 1
  truthy:
    allowed-values: ["true", "false"]
    check-keys: false
  document-start:
    present: true
  # Kept in sync with ansible-lint's expected yamllint rules (silences its
  # "incompatible custom yamllint configuration" warning).
  comments-indentation: false
  braces:
    max-spaces-inside: 1
  octal-values:
    forbid-implicit-octal: true
    forbid-explicit-octal: true
