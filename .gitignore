# --- Secrets & sensitive data (never publish) ---
# Server access notes.
server.txt
# 3x-ui database: contains clients, UUIDs, REALITY keys, passwords.
backups/
*.db
# Personal client-side routing config (Shadowrocket).
default_ru.conf

# --- Host-specific inventory (copy hosts.example.yml -> hosts.yml) ---
inventories/production/hosts.yml
# Local-run inventory (copy hosts.local.example.yml -> hosts.local.yml)
inventories/production/hosts.local.yml

# --- Secrets (copy secrets.example.yml -> secrets.yml, then ansible-vault encrypt) ---
# Encrypted at rest, but still kept out of git: a vault password leak must not
# also be a credential leak.
inventories/production/secrets.yml
# Vault password, if you choose a file over --ask-vault-pass.
.vault_pass

# --- Ansible runtime artifacts ---
.ansible/
*.retry

# --- OS / editor noise ---
.DS_Store
**/.DS_Store
*.swp
.idea/
.vscode/

# Local virtualenvs, e.g. for the Molecule stack in molecule/requirements.txt.
.venv*/
